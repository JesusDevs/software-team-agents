# ── LLM Provider (usa uno de los dos) ────────────────────────────────────────
# OpenAI — LLM + embeddings RAG (necesario para RAG aunque uses OpenRouter)
OPENAI_API_KEY=sk-...

# OpenRouter — alternativa gratuita para LLM (no incluye embeddings)
# Obtén tu key en: https://openrouter.ai/keys
# Modelos gratis: meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-r1:free
# Si ambas keys están presentes, OpenAI tiene prioridad
OPENROUTER_API_KEY=sk-or-...

# LangSmith — opcional, activa trazas automáticas
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=software-team-agents

# Configuración del proyecto
DEFAULT_RUN_ID=default
LOG_LEVEL=INFO
